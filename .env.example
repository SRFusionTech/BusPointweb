# ─────────────────────────────────────────────────────────────────────────────
# BusPoint Web — SRFusion
# Copy this file to .env (shared secrets/keys) and fill in your values.
# The API URL is NOT set here: .env.development (dev → localhost) and
# .env.production (build → https://api.buspoint.in) are committed.
# Keys marked [ACTIVE] are used now. [FUTURE] = wired but not enabled yet.
# ─────────────────────────────────────────────────────────────────────────────

# ─── API [ACTIVE] ────────────────────────────────────────────────────────────

# ─── Maps [FUTURE] — school admin live tracking map ──────────────────────────
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Firebase [FUTURE] — web push notifications ──────────────────────────────
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ─── Analytics [FUTURE] ──────────────────────────────────────────────────────
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# ─── Sentry [FUTURE] ─────────────────────────────────────────────────────────
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Example env for web apps (copy to apps/*/.env.local or to this file as guidance)
# API base used by Next.js apps (must include /api)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Only needed on the landing app — destinations the unified /login page sends
# users to after a successful auth. In production, set these to the deployed
# Vercel URLs of each dashboard.
NEXT_PUBLIC_SCHOOL_ADMIN_URL=http://localhost:3020
NEXT_PUBLIC_SUPER_ADMIN_URL=http://localhost:3030

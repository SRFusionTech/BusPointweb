{
  "name": "buspoint-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "lint:tokens": "node design/lint-tokens.mjs src",
    "verify": "npm run typecheck && npm run lint:tokens",
    "build:backend": "next build && node -e \"const fs=require('fs');const d='../BusPointBackend/public';fs.rmSync(d,{recursive:true,force:true});fs.cpSync('out',d,{recursive:true});console.log('Copied out/ -> '+d)\""
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@mantine/charts": "^9.7.5",
    "@mantine/core": "^9.7.5",
    "@mantine/hooks": "^9.7.5",
    "@mantine/notifications": "^9.7.5",
    "@mantine/nprogress": "^9.7.5",
    "@mantine/spotlight": "^9.7.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tabler/icons-react": "^3.50.0",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/google.maps": "^3.66.9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
